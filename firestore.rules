rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Admin is matched by Firebase Auth UID. Add more UIDs to the list for extra admins.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['0z5mSAy9WncLHiLd209Rmhy5zgn1'];
    }

    // Published posts are public at once; scheduled posts once their time has passed.
    function isLive() {
      return resource.data.status == 'published'
        || (resource.data.status == 'scheduled' && resource.data.publishedAt <= request.time);
    }

    function validPost() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.slug is string && d.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && d.status in ['draft', 'published', 'scheduled']
        && d.contentHtml is string && d.contentHtml.size() < 900000;
    }

    match /posts/{postId} {
      allow read: if isLive() || isAdmin();
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
